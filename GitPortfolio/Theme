/* Active */
:root {
  --bg-1: #0e0e10;
  --bg-2: #141416;
  --bg-3: #1a1a1c;

  --accent: #7c6dfa;
  --accent-tint: #1e1a3a;

  --text-heading: #f0f0f0;
  --text-body: #9090a0;
  --text-muted: #55555f;

  --surface-ink: #08080a;
  --surface-nav: #0e0e10;
  --surface-footer: #050507;
  
  --border: #2a2a30;
  --border-dark: rgba(255,255,255,0.06);
}

/* Main */
:root{
      /* Backgrounds */
  --bg-1: #f0f0ec;
  --bg-2: #eeede9;
  --bg-3: #fafafa;

  /* Accent */
  --accent: #f55d00;
  --accent-tint: #fde8db;

  /* Text */
  --text-heading: #0f0f0f;
  --text-body: #444444;
  --text-muted: #999999;

  /* Dark surfaces */
  --surface-ink: #1a1a1c;
  --surface-nav: #111827;
  --surface-footer: #222325;

  /* Borders */
  --border: #d9d5cf;
  --border-dark: rgba(255, 255, 255, 0.08);
}




